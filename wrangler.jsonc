{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownwan-villa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownwan-villa",
      "database_id": "b90c5080-894b-4ccb-9f75-0441d23cdb72",
      "migrations_dir": "migrations"
    }
  ],
  // 사진 저장: 지금은 D1(photo_blobs). R2를 켜면 아래 r2_buckets 주석을 풀고 PHOTO_STORAGE를 "r2"로 바꾼다 (docs/launch-checklist.md)
  "vars": { "PHOTO_STORAGE": "d1" },
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ownwan-villa-photos" }],
  "triggers": { "crons": ["0 15 * * *"] }
}
