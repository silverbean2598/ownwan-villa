{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownwan-villa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownwan-villa",
      // 배포 전 `wrangler d1 create ownwan-villa`로 받은 ID로 교체
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // 사진 저장: 지금은 D1(photo_blobs). R2를 켜면 아래 r2_buckets 주석을 풀고 PHOTO_STORAGE를 "r2"로 바꾼다 (docs/launch-checklist.md)
  "vars": { "PHOTO_STORAGE": "d1" },
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ownwan-villa-photos" }],
  "triggers": { "crons": ["0 15 * * *"] }
}
